+    #[test]
+    fn embedding_failure_on_reindex_does_not_delete_the_previous_successful_index() {
+        // Regression test for a real production bug: `run_pipeline` used
+        // to call `chunks.delete_for_document` unconditionally before
+        // embedding the new parse, so an embedding failure on re-index
+        // (most commonly "no model currently assigned to
+        // EngineRole::Embedding", or the assigned model becoming
+        // unavailable) deleted every previously-indexed chunk/vector for
+        // the document and then aborted -- permanently un-indexing it
+        // until some later re-index happened to run with a working
+        // embedding model again.
+        struct FailingEmbeddingEngine;
+        impl crate::embedding::EmbeddingEngine for FailingEmbeddingEngine {
+            fn dimensions(&self) -> usize {
+                1
+            }
+            fn embed(&self, _text: &str) -> Result<crate::embedding::Embedding, AppError> {
+                Err(AppError::model("no model currently assigned to EngineRole::Embedding"))
+            }
+        }
+
+        let documents = Arc::new(InMemoryDocumentRepository::new());
+        let chunks = Arc::new(InMemoryChunkRepository::new());
+        let vector_store = Arc::new(InMemoryVectorStore::new());
+        let embeddings = Arc::new(InMemoryEmbeddingRepository::new());
+
+        let working_pipeline = IndexingPipeline::new(
+            documents.clone(),
+            chunks.clone(),
+            Arc::new(default_parser_selector()),
+            Arc::new(LayeredSettingsProvider::new()),
+            Arc::new(InMemoryEventBus::new()),
+            Arc::new(NoopOcrEngine),
+            Arc::new(HashEmbeddingEngine::default()),
+            embeddings.clone(),
+            vector_store.clone(),
+        );
+
+        let path = temp_file("md-embed-fail", "# Title\n\nOriginal content here.");
+        working_pipeline
+            .index_document(WorkspaceId(1), "embed-fail.md", path.to_str().unwrap())
+            .unwrap();
+        let docs = working_pipeline.documents().list_for_workspace(WorkspaceId(1)).unwrap();
+        let chunk_count_before = working_pipeline.chunks().list_for_document(docs[0].id).unwrap().len();
+        assert!(chunk_count_before > 0);
+
+        // Now re-index changed content through a pipeline whose embedder
+        // always fails -- simulating the embedding model having been
+        // removed/unassigned since the first successful index.
+        let failing_pipeline = IndexingPipeline::new(
+            documents,
+            chunks,
+            Arc::new(default_parser_selector()),
+            Arc::new(LayeredSettingsProvider::new()),
+            Arc::new(InMemoryEventBus::new()),
+            Arc::new(NoopOcrEngine),
+            Arc::new(FailingEmbeddingEngine),
+            embeddings,
+            vector_store,
+        );
+        std::fs::write(&path, "# Title\n\nCompletely different content now.").unwrap();
+        let err = failing_pipeline
+            .index_document(WorkspaceId(1), "embed-fail.md", path.to_str().unwrap())
+            .unwrap_err();
+        assert_eq!(err.category, atlas_utils::ErrorCategory::ModelError);
+
+        // The previously-indexed chunks must still be there, untouched --
+        // not deleted just because the re-index attempt failed.
+        let chunks_after = failing_pipeline.chunks().list_for_document(docs[0].id).unwrap();
+        assert_eq!(chunks_after.len(), chunk_count_before);
+        assert!(chunks_after.iter().any(|c| c.text_content.contains("Original")));
+
+        let _ = std::fs::remove_file(&path);
+    }
+
